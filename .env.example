SUPPORT_ADDR=127.0.0.1:8090
SUPPORT_DB=.local/support.db
# Shared operator token for this private CRM. Minimum 32 random characters.
SUPPORT_ACCESS_TOKEN=
# Enable when browsers access HTTPS, including behind a reverse proxy.
SUPPORT_SECURE_COOKIES=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Direct private-network endpoint or localhost reached through an SSH tunnel.
PROJECT_MCP_URL=http://127.0.0.1:8091/mcp
PROJECT_MCP_TOKEN=
# Import clearly labelled demonstration tickets only on an empty database.
SUPPORT_SEED_DEMO=false
