[Unit]
Description=Project Desk SQLite backup
After=projectdesk.service

[Service]
Type=oneshot
User=projectdesk
Group=projectdesk
ExecStart=/usr/bin/python3 /opt/projectdesk/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/projectdesk
