+package supportmcp
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func fileFixture(t *testing.T) (*workspace, string) {
+	t.Helper()
+	root := projectRoot(t)
+	for name, content := range map[string]string{"main.go": "package main\nfunc authenticate() {}\n", "web/app.js": "fetch('/api/chat');\n", "tools.go": "package main\n// authenticate reads a token\n", ".env": "SECRET_TOKEN=never-return-this", "docs/current.md": "Existing documentation\n"} {
+		p := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(p), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	w, err := newWorkspace(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return w, root
+}
