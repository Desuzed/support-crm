+package supportmcp
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"ai-challenge-app/internal/rag"
+	"ai-challenge-app/internal/ragindex"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+type stubRetriever struct{ err error }
+
+func (s stubRetriever) IndexInfo() (rag.IndexInfo, error) {
+	return rag.IndexInfo{Model: "embeddinggemma", Files: 1, Chunks: 1}, s.err
+}
+func (s stubRetriever) SearchWithOptions(context.Context, string, rag.SearchOptions) (rag.SearchResult, error) {
+	return rag.SearchResult{Matches: []rag.Match{{Chunk: ragindex.Chunk{Source: "README.md", ChunkID: "readme-1", Text: "Project documentation"}}, {Chunk: ragindex.Chunk{Source: ".env", ChunkID: "secret", Text: "SECRET"}}}}, s.err
+}
+
+type authRT struct{ token string }
+
+func (a authRT) RoundTrip(r *http.Request) (*http.Response, error) {
+	r = r.Clone(r.Context())
+	r.Header.Set("Authorization", "Bearer "+a.token)
+	return http.DefaultTransport.RoundTrip(r)
+}
+func projectRoot(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	if err := os.Mkdir(filepath.Join(root, "docs"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "README.md"), []byte("Project docs"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+func TestMCPProtocolAndCorpusIsolation(t *testing.T) {
+	root := projectRoot(t)
+	token := strings.Repeat("a", 40)
+	h, err := Handler(Config{Root: root, Token: token, Retriever: stubRetriever{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(h)
+	defer server.Close()
+	res, err := http.Get(server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	if res.StatusCode != 401 {
+		t.Fatalf("missing token: %d", res.StatusCode)
+	}
+	ctx := context.Background()
+	session, err := mcp.NewClient(&mcp.Implementation{Name: "test", Version: "1"}, nil).Connect(ctx, &mcp.StreamableClientTransport{Endpoint: server.URL, HTTPClient: &http.Client{Transport: authRT{token}}, DisableStandaloneSSE: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer session.Close()
+	list, err := session.ListTools(ctx, nil)
+	if err != nil || len(list.Tools) != 3 {
+		t.Fatalf("tools: %v %v", list, err)
+	}
+	result, err := session.CallTool(ctx, &mcp.CallToolParams{Name: "project_search_docs", Arguments: map[string]any{"question": "project documentation", "limit": 4}})
+	if err != nil || result.IsError {
+		t.Fatalf("call: %v %v", result, err)
+	}
+	data, _ := json.Marshal(result.StructuredContent)
+	var found SearchResult
+	if json.Unmarshal(data, &found) != nil || len(found.Evidence) != 1 || found.Evidence[0].Source != "README.md" {
+		t.Fatalf("corpus leak: %s", data)
+	}
+	result, err = session.CallTool(ctx, &mcp.CallToolParams{Name: "project_read_document", Arguments: map[string]string{"path": ".env"}})
+	if err != nil || !result.IsError {
+		t.Fatalf("secret read was allowed: %v %v", result, err)
+	}
+	req, _ := http.NewRequest("GET", server.URL, nil)
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Origin", "http://evil.invalid")
+	res, err = http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.Body.Close()
+	if res.StatusCode != 403 {
+		t.Fatal("browser origin accepted")
+	}
+}
+func TestReadDocumentRejectsTraversalAndSymlinks(t *testing.T) {
+	root := projectRoot(t)
+	_ = os.WriteFile(filepath.Join(root, ".env"), []byte("SECRET"), 0600)
+	if err := os.Symlink(filepath.Join(root, ".env"), filepath.Join(root, "docs", "leak.md")); err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range []string{"../README.md", "docs/../.env", ".env", "docs/leak.md", "/etc/passwd", "docs\\file.md"} {
+		if _, err := readDocument(root, p); err == nil {
+			t.Errorf("accepted %q", p)
+		}
+	}
+	doc, err := readDocument(root, "README.md")
+	if err != nil || doc.Text != "Project docs" {
+		t.Fatalf("read: %v %v", doc, err)
+	}
+}
