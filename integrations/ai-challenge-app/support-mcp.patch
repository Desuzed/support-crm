+func TestPreviewSaveNoOpAndConflict(t *testing.T) {
+	w, root := fileFixture(t)
+	in := fileWriteInput{Path: "docs/generated/ADR.md", Content: "# ADR\nDerived from main.go, tools.go and web/app.js.\n", ExpectedSHA256: "missing"}
+	preview, err := w.write(in, false)
+	if err != nil || preview.Saved || !preview.Changed || !strings.Contains(preview.Diff, "--- /dev/null") {
+		t.Fatalf("preview: %+v %v", preview, err)
+	}
+	if _, err = os.Stat(filepath.Join(root, in.Path)); !os.IsNotExist(err) {
+		t.Fatal("preview saved a file")
+	}
+	saved, err := w.write(in, true)
+	if err != nil || !saved.Saved || !saved.Changed || saved.Diff != preview.Diff {
+		t.Fatalf("save: %+v %v", saved, err)
+	}
+	data, _ := os.ReadFile(filepath.Join(root, in.Path))
+	if string(data) != in.Content {
+		t.Fatal("file was not persisted")
+	}
+	in.ExpectedSHA256 = saved.SHA256
+	again, err := w.write(in, true)
+	if err != nil || !again.Saved || again.Changed || again.Diff != "" {
+		t.Fatalf("repeat: %+v %v", again, err)
+	}
+	_ = os.WriteFile(filepath.Join(root, in.Path), []byte("Operator's edit\n"), 0600)
+	if _, err = w.write(in, true); err == nil || !strings.Contains(err.Error(), "file_conflict") {
+		t.Fatal("concurrent change overwritten")
+	}
+	data, _ = os.ReadFile(filepath.Join(root, in.Path))
+	if string(data) != "Operator's edit\n" {
+		t.Fatal("conflict lost operator content")
+	}
+}
