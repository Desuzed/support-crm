+package main
+
+import (
+	"flag"
+	"log"
+	"net/http"
+	"os"
+	"path/filepath"
+	"time"
+
+	"ai-challenge-app/internal/rag"
+	"ai-challenge-app/internal/ragindex"
+	"ai-challenge-app/internal/supportmcp"
+)
+
+func main() {
+	root := flag.String("root", ".", "project root")
+	addr := flag.String("addr", "127.0.0.1:8091", "listen address; use an SSH tunnel for remote access")
+	flag.Parse()
+	abs, err := filepath.Abs(*root)
+	if err != nil {
+		log.Fatal(err)
+	}
+	url := os.Getenv("SUPPORT_EMBEDDING_URL")
+	if url == "" {
+		url = "http://127.0.0.1:11434"
+	}
+	model := os.Getenv("SUPPORT_EMBEDDING_MODEL")
+	if model == "" {
+		model = "embeddinggemma"
+	}
+	h, err := supportmcp.Handler(supportmcp.Config{Root: abs, Token: os.Getenv("SUPPORT_MCP_TOKEN"), DeepSeekConfigured: os.Getenv("DEEPSEEK_API_KEY") != "", GitHubConfigured: os.Getenv("GITHUB_TOKEN") != "", Retriever: &rag.Searcher{Root: abs, IndexDir: filepath.Join(abs, ".local/rag"), Model: model, Embedder: ragindex.Ollama{URL: url, Model: model, KeepAlive: "0"}}})
+	if err != nil {
+		log.Fatal(err)
+	}
+	mux := http.NewServeMux()
+	mux.Handle("/mcp", h)
+	server := &http.Server{Addr: *addr, Handler: mux, ReadHeaderTimeout: 5 * time.Second, IdleTimeout: 60 * time.Second, MaxHeaderBytes: 16 << 10}
+	log.Printf("Project knowledge MCP listening on %s (generation: external support service)", *addr)
+	log.Fatal(server.ListenAndServe())
+}
