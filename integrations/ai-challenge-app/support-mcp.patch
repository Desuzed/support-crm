+func TestFileWorkspaceRejectsSecretsSymlinksAndCodeWrites(t *testing.T) {
+	w, root := fileFixture(t)
+	_ = os.Symlink(filepath.Join(root, ".env"), filepath.Join(root, "docs", "leak.md"))
+	_ = os.MkdirAll(filepath.Join(root, ".local"), 0700)
+	_ = os.WriteFile(filepath.Join(root, ".local", "secret.md"), []byte("PRIVATE"), 0600)
+	_ = os.Symlink(filepath.Join(root, ".local"), filepath.Join(root, "docs", "linked"))
+	for _, p := range []string{".env", "docs/leak.md", "../README.md", "/etc/passwd", "docs/../README.md", "docs\\bad.md", ".local/secret.md", "docs/linked/secret.md"} {
+		if _, err := w.read(fileReadInput{Path: p}); err == nil {
+			t.Errorf("read allowed: %q", p)
+		}
+		if _, err := w.write(fileWriteInput{Path: p, Content: "x", ExpectedSHA256: "missing"}, true); err == nil {
+			t.Errorf("write allowed: %q", p)
+		}
+	}
+	if _, err := w.write(fileWriteInput{Path: "main.go", Content: "replace", ExpectedSHA256: "missing"}, true); err == nil {
+		t.Fatal("code write accepted")
+	}
+	listed, err := w.list(context.Background(), fileListInput{Limit: 200})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, p := range listed.Files {
+		if strings.Contains(p, "leak") || strings.Contains(p, "secret") || strings.Contains(p, "linked") {
+			t.Fatalf("private path listed: %q", p)
+		}
+	}
+}
