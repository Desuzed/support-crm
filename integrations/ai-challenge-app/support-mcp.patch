@@ -0,0 +1,229 @@
+// Package supportmcp exposes project knowledge independently of the web app.
+package supportmcp
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/hex"
+	"errors"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"ai-challenge-app/internal/rag"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+type Retriever interface {
+	SearchWithOptions(context.Context, string, rag.SearchOptions) (rag.SearchResult, error)
+	IndexInfo() (rag.IndexInfo, error)
+}
+
+type Config struct {
+	Root      string
+	FilesRoot string // Optional workspace for file tools; defaults to Root.
+	Token     string
+	Retriever Retriever
+	// Values are loaded by the executable. Only presence flags are returned.
+	DeepSeekConfigured bool
+	GitHubConfigured   bool
+}
+
+type Evidence struct {
+	ID      string  `json:"id"`
+	Source  string  `json:"source"`
+	Section string  `json:"section,omitempty"`
+	Text    string  `json:"text"`
+	Score   float64 `json:"score,omitempty"`
+}
+
+type SearchResult struct {
+	Mode     string     `json:"mode"`
+	Evidence []Evidence `json:"evidence"`
+}
+
+type Info struct {
+	FileToolsVersion   int    `json:"fileToolsVersion"`
+	FileWorkspace      string `json:"fileWorkspace"`
+	Project            string `json:"project"`
+	Branch             string `json:"branch,omitempty"`
+	Commit             string `json:"commit,omitempty"`
+	CapturedAt         string `json:"capturedAt"`
+	IndexStatus        string `json:"indexStatus"`
+	EmbeddingModel     string `json:"embeddingModel,omitempty"`
+	Files              int    `json:"files"`
+	Chunks             int    `json:"chunks"`
+	DeepSeekConfigured bool   `json:"deepseekConfigured"`
+	GitHubConfigured   bool   `json:"githubConfigured"`
+}
+
+func Handler(cfg Config) (http.Handler, error) {
+	if len(cfg.Token) < 32 {
+		return nil, errors.New("SUPPORT_MCP_TOKEN must contain at least 32 characters")
+	}
+	root, err := filepath.Abs(cfg.Root)
+	if err != nil {
+		return nil, err
+	}
+	cfg.Root = root
+	if _, err := os.Stat(filepath.Join(root, "README.md")); err != nil {
+		return nil, errors.New("project README.md not found")
+	}
+	s := mcp.NewServer(&mcp.Implementation{Name: "ai-challenge-project-knowledge", Version: "1.0.0"}, nil)
+	no := false
+	annotation := &mcp.ToolAnnotations{ReadOnlyHint: true, DestructiveHint: &no, OpenWorldHint: &no}
+	if cfg.FilesRoot == "" {
+		cfg.FilesRoot = root
+	}
+	workspace, err := newWorkspace(cfg.FilesRoot)
+	if err != nil {
+		return nil, err
+	}
+	registerFileTools(s, workspace, annotation)
+	mcp.AddTool(s, &mcp.Tool{Name: "project_search_docs", Description: "Search the existing project RAG index. Returns exact source text and evidence IDs. No secrets or CRM data.", Annotations: annotation}, func(ctx context.Context, _ *mcp.CallToolRequest, in struct {
+		Question string `json:"question"`
+		Limit    int    `json:"limit,omitempty"`
+	}) (*mcp.CallToolResult, SearchResult, error) {
+		if len(strings.TrimSpace(in.Question)) == 0 || len(in.Question) > 8000 {
+			return nil, SearchResult{}, errors.New("question must contain 1–8000 bytes")
+		}
+		if cfg.Retriever == nil {
+			return nil, SearchResult{}, errors.New("RAG is not configured")
+		}
+		options := rag.DefaultSearchOptions()
+		options.ResultLimit = min(6, max(1, in.Limit))
+		options.CandidateLimit = max(12, options.ResultLimit)
+		q := strings.ToLower(in.Question)
+		options.ProjectOverview = strings.Contains(q, "расскажи о проекте") || strings.Contains(q, "что это за проект")
+		ctx, cancel := context.WithTimeout(ctx, 35*time.Second)
+		defer cancel()
+		result, err := cfg.Retriever.SearchWithOptions(ctx, in.Question, options)
+		if err != nil {
+			return nil, SearchResult{}, safeRAGError(err)
+		}
+		out := SearchResult{Mode: "rag", Evidence: []Evidence{}}
+		for _, match := range result.Matches {
+			// An index is data, not permission to read arbitrary paths.
+			if !allowedSource(match.Chunk.Source) {
+				continue
+			}
+			out.Evidence = append(out.Evidence, Evidence{ID: match.Chunk.ChunkID, Source: match.Chunk.Source, Section: match.Chunk.Section, Text: match.Chunk.Text, Score: match.Score})
+		}
+		return nil, out, nil
+	})
+	mcp.AddTool(s, &mcp.Tool{Name: "project_read_document", Description: "Read README.md or a UTF-8 document under docs. Useful when the RAG index itself is unavailable. Never reads env, history, reports or credentials.", Annotations: annotation}, func(_ context.Context, _ *mcp.CallToolRequest, in struct {
+		Path string `json:"path"`
+	}) (*mcp.CallToolResult, Evidence, error) {
+		out, err := readDocument(root, in.Path)
+		return nil, out, err
+	})
+	mcp.AddTool(s, &mcp.Tool{Name: "project_get_info", Description: "Current project revision and actual RAG index health. Credential flags expose presence only. Does not test external provider connectivity.", Annotations: annotation}, func(ctx context.Context, _ *mcp.CallToolRequest, _ struct{}) (*mcp.CallToolResult, Info, error) {
+		out := Info{FileToolsVersion: 1, FileWorkspace: filepath.Base(cfg.FilesRoot), Project: "ai-challenge-app", CapturedAt: time.Now().UTC().Format(time.RFC3339), IndexStatus: "not_configured", DeepSeekConfigured: cfg.DeepSeekConfigured, GitHubConfigured: cfg.GitHubConfigured}
+		out.Branch = git(ctx, root, "branch", "--show-current")
+		out.Commit = git(ctx, root, "rev-parse", "HEAD")
+		if cfg.Retriever != nil {
+			info, err := cfg.Retriever.IndexInfo()
+			if err != nil {
+				out.IndexStatus = safeRAGError(err).Error()
+			} else {
+				out.IndexStatus = "ready"
+				out.EmbeddingModel = info.Model
+				out.Files = info.Files
+				out.Chunks = info.Chunks
+			}
+		}
+		return nil, out, nil
+	})
+	transport := mcp.NewStreamableHTTPHandler(func(*http.Request) *mcp.Server { return s }, &mcp.StreamableHTTPOptions{Stateless: true, JSONResponse: true, MaxRequestBodyBytes: 256 << 10})
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		if r.Header.Get("Origin") != "" {
+			http.Error(w, "browser access is not supported", http.StatusForbidden)
+			return
+		}
+		if !strings.HasPrefix(r.Header.Get("Authorization"), "Bearer ") {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		auth := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		if subtle.ConstantTimeCompare([]byte(auth), []byte(cfg.Token)) != 1 {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		transport.ServeHTTP(w, r)
+	}), nil
+}
+
+func allowedSource(p string) bool {
+	if strings.Contains(p, "\\") || strings.Contains(p, "..") || filepath.IsAbs(p) {
+		return false
+	}
+	if p == "README.md" {
+		return true
+	}
+	if strings.HasPrefix(p, "docs/") {
+		switch filepath.Ext(p) {
+		case ".md", ".txt", ".json", ".yaml", ".yml":
+			return true
+		}
+	}
+	return strings.HasPrefix(p, "internal/") && strings.HasSuffix(p, ".go") || p == "main.go"
+}
+
+func readDocument(root, p string) (Evidence, error) {
+	if !allowedSource(p) || !(p == "README.md" || strings.HasPrefix(p, "docs/")) {
+		return Evidence{}, errors.New("document is outside the allowed corpus")
+	}
+	path := filepath.Join(root, filepath.FromSlash(p))
+	real, err := filepath.EvalSymlinks(path)
+	if err != nil {
+		return Evidence{}, errors.New("document not found")
+	}
+	base, err := filepath.EvalSymlinks(root)
+	if err != nil {
+		return Evidence{}, errors.New("project root unavailable")
+	}
+	rel, err := filepath.Rel(base, real)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return Evidence{}, errors.New("document escapes project root")
+	}
+	if filepath.Clean(rel) != filepath.Clean(filepath.FromSlash(p)) {
+		return Evidence{}, errors.New("symbolic links are not allowed in documents")
+	}
+	data, err := os.ReadFile(real)
+	if err != nil {
+		return Evidence{}, errors.New("document cannot be read")
+	}
+	if len(data) > 64<<10 {
+		return Evidence{}, errors.New("document exceeds 64 KiB")
+	}
+	hash := sha256.Sum256(data)
+	return Evidence{ID: "document:" + p + ":" + hex.EncodeToString(hash[:8]), Source: p, Text: string(data)}, nil
+}
+
+func safeRAGError(err error) error {
+	switch {
+	case errors.Is(err, rag.ErrIndexMissing):
+		return errors.New("index_missing")
+	case errors.Is(err, rag.ErrIndexStale):
+		return errors.New("index_stale")
+	case errors.Is(err, rag.ErrEmbeddingUnavailable):
+		return errors.New("embedding_unavailable")
+	default:
+		return errors.New("rag_unavailable")
+	}
+}
+
+func git(ctx context.Context, root string, args ...string) string {
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	out, err := exec.CommandContext(ctx, "git", append([]string{"-C", root}, args...)...).Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
