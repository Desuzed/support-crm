+func TestCurrentFileSearchAndPaginatedReads(t *testing.T) {
+	w, root := fileFixture(t)
+	out, err := w.search(context.Background(), fileSearchInput{Query: "AUTHENTICATE", Limit: 1})
+	if err != nil || len(out.Evidence) != 1 || !out.Truncated || out.NextOffset != 1 {
+		t.Fatalf("page 1: %+v %v", out, err)
+	}
+	next, err := w.search(context.Background(), fileSearchInput{Query: "AUTHENTICATE", Limit: 1, Offset: out.NextOffset})
+	if err != nil || len(next.Evidence) != 1 || next.Truncated || next.Evidence[0].Source == out.Evidence[0].Source {
+		t.Fatalf("page 2: %+v %v", next, err)
+	}
+	doc, err := w.read(fileReadInput{Path: "main.go", Limit: 1})
+	if err != nil || !doc.Truncated || doc.StartLine != 1 || doc.EndLine != 1 {
+		t.Fatalf("read: %+v %v", doc, err)
+	}
+	_ = os.WriteFile(filepath.Join(root, "main.go"), []byte("package main\n// changed\n"), 0600)
+	newDoc, err := w.read(fileReadInput{Path: "main.go"})
+	if err != nil || doc.SHA256 == newDoc.SHA256 {
+		t.Fatal("reading stale content")
+	}
+}
