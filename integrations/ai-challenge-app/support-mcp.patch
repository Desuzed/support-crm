index 0000000..2d61248
--- /dev/null
+++ b/internal/supportmcp/files.go
@@ -0,0 +1,418 @@
+package supportmcp
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+	"sync"
+	"unicode/utf8"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+const fileLimit = 512 << 10
+const documentLimit = 32 << 10
+
+// The workspace has no command execution tool. A root handle confines all IO,
+// including concurrent path replacement, to the configured workspace.
+type workspace struct {
+	dir string
+	mu  sync.Mutex
+}
+
+func newWorkspace(dir string) (*workspace, error) {
+	abs, err := filepath.Abs(dir)
+	if err != nil {
+		return nil, errors.New("file workspace unavailable")
+	}
+	r, err := os.OpenRoot(abs)
+	if err != nil {
+		return nil, errors.New("file workspace unavailable")
+	}
+	r.Close()
+	return &workspace{dir: abs}, nil
+}
+
+type fileListInput struct {
+	Prefix string `json:"prefix,omitempty"`
+	Offset int    `json:"offset,omitempty"`
+	Limit  int    `json:"limit,omitempty"`
+}
+type fileList struct {
+	Files      []string `json:"files"`
+	NextOffset int      `json:"nextOffset,omitempty"`
+	Truncated  bool     `json:"truncated"`
+}
+type fileSearchInput struct {
+	Query  string `json:"query"`
+	Prefix string `json:"prefix,omitempty"`
+	Offset int    `json:"offset,omitempty"`
+	Limit  int    `json:"limit,omitempty"`
+}
+type fileReadInput struct {
+	Path      string `json:"path"`
+	StartLine int    `json:"startLine,omitempty"`
+	Limit     int    `json:"limit,omitempty"`
+}
+type fileRead struct {
+	Evidence
+	SHA256     string `json:"sha256"`
+	StartLine  int    `json:"startLine"`
+	EndLine    int    `json:"endLine"`
+	TotalLines int    `json:"totalLines"`
+	Truncated  bool   `json:"truncated"`
+}
+type fileSearch struct {
+	Evidence     []Evidence `json:"evidence"`
+	NextOffset   int        `json:"nextOffset,omitempty"`
+	Truncated    bool       `json:"truncated"`
+	SkippedFiles int        `json:"skippedFiles"`
+}
+type fileWriteInput struct {
+	Path           string `json:"path"`
+	Content        string `json:"content"`
+	ExpectedSHA256 string `json:"expectedSha256"`
+}
+type fileWrite struct {
+	Path    string `json:"path"`
+	Changed bool   `json:"changed"`
+	Saved   bool   `json:"saved"`
+	SHA256  string `json:"sha256"`
+	Diff    string `json:"diff"`
+}
+
+func registerFileTools(s *mcp.Server, w *workspace, readOnly *mcp.ToolAnnotations) {
+	mcp.AddTool(s, &mcp.Tool{Name: "project_list_files", Description: "List public source and documentation paths in fileWorkspace, sorted, with pagination. Hidden/private/generated files and symlinks are excluded. prefix is a literal path prefix.", Annotations: readOnly}, func(ctx context.Context, _ *mcp.CallToolRequest, in fileListInput) (*mcp.CallToolResult, fileList, error) {
+		out, err := w.list(ctx, in)
+		return nil, out, err
+	})
+	mcp.AddTool(s, &mcp.Tool{Name: "project_search_files", Description: "Case-insensitive literal search in current files, independent of RAG. Returns path:line references and exact matching lines. Follow nextOffset while truncated; skippedFiles counts oversized/unreadable files.", Annotations: readOnly}, func(ctx context.Context, _ *mcp.CallToolRequest, in fileSearchInput) (*mcp.CallToolResult, fileSearch, error) {
+		out, err := w.search(ctx, in)
+		return nil, out, err
+	})
+	mcp.AddTool(s, &mcp.Tool{Name: "project_read_file", Description: "Read current UTF-8 source/documentation in fileWorkspace, with SHA256 of the entire file. Lines are 1-based, default limit 160, maximum 240; read subsequent ranges if truncated.", Annotations: readOnly}, func(_ context.Context, _ *mcp.CallToolRequest, in fileReadInput) (*mcp.CallToolResult, fileRead, error) {
+		out, err := w.read(in)
+		return nil, out, err
+	})
+	no := false
+	mcp.AddTool(s, &mcp.Tool{Name: "project_write_file", Description: "Save README.md, CHANGELOG.md or Markdown under docs in fileWorkspace, max 32 KiB; returns actual unified diff. expectedSha256 MUST be the hash from project_read_file, or missing for a new file. An unchanged write is a no-op. Only use when the user requests a saved change.", Annotations: &mcp.ToolAnnotations{DestructiveHint: &no, OpenWorldHint: &no}}, func(_ context.Context, _ *mcp.CallToolRequest, in fileWriteInput) (*mcp.CallToolResult, fileWrite, error) {
+		out, err := w.write(in, true)
+		return nil, out, err
+	})
+	mcp.AddTool(s, &mcp.Tool{Name: "project_preview_diff", Description: "Preview a unified diff using the same arguments and conflict checks as project_write_file, without saving. Use when the user asks only to propose or review a change.", Annotations: readOnly}, func(_ context.Context, _ *mcp.CallToolRequest, in fileWriteInput) (*mcp.CallToolResult, fileWrite, error) {
+		out, err := w.write(in, false)
+		return nil, out, err
+	})
+}
+
+func allowedFile(p string) bool {
+	if p == "" || strings.ContainsAny(p, "\\:\x00") || strings.HasPrefix(p, "/") || path.Clean(p) != p {
+		return false
+	}
+	for _, part := range strings.Split(p, "/") {
+		if strings.HasPrefix(part, ".") {
+			return false
+		}
+		switch strings.ToLower(part) {
+		case "node_modules", "vendor", "dist", "build", "coverage", "data", "storage", "secrets", "credentials", "private", "venv", "__pycache__":
+			return false
+		}
+	}
+	switch strings.ToLower(path.Ext(p)) {
+	case ".go", ".js", ".ts", ".tsx", ".jsx", ".md", ".css", ".html", ".json", ".yaml", ".yml", ".toml", ".txt", ".sh", ".py", ".ps1", ".sql", ".mod":
+		return true
+	}
+	return false
+}
+
+func writableDocument(p string) bool {
+	return allowedFile(p) && (p == "README.md" || p == "CHANGELOG.md" || strings.HasPrefix(p, "docs/") && strings.HasSuffix(p, ".md"))
+}
+
+func checkPath(r *os.Root, p string) error {
+	if !allowedFile(p) {
+		return errors.New("file is outside the allowed workspace corpus")
+	}
+	parts := strings.Split(p, "/")
+	for i := range parts {
+		info, err := r.Lstat(strings.Join(parts[:i+1], "/"))
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil
+		}
+		if err != nil || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("symlinks and inaccessible paths are not allowed")
+		}
+		if i == len(parts)-1 && !info.Mode().IsRegular() {
+			return errors.New("only regular files are allowed")
+		}
+	}
+	return nil
+}
+
+func readText(r *os.Root, p string) ([]byte, error) {
+	if err := checkPath(r, p); err != nil {
+		return nil, err
+	}
+	f, err := r.Open(p)
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, fs.ErrNotExist
+	}
+	if err != nil {
+		return nil, errors.New("file cannot be opened")
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		return nil, errors.New("only regular files are allowed")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, fileLimit+1))
+	if err != nil || len(data) > fileLimit || !utf8.Valid(data) || strings.ContainsRune(string(data), '\x00') {
+		return nil, errors.New("file is not UTF-8 text within 512 KiB")
+	}
+	return data, nil
+}
+
+func digest(data []byte) string { hash := sha256.Sum256(data); return hex.EncodeToString(hash[:]) }
+
+func (w *workspace) list(ctx context.Context, in fileListInput) (fileList, error) {
+	out := fileList{Files: []string{}}
+	if in.Offset < 0 || in.Offset > 100000 || len(in.Prefix) > 256 {
+		return out, errors.New("invalid pagination or prefix")
+	}
+	r, err := os.OpenRoot(w.dir)
+	if err != nil {
+		return out, errors.New("workspace unavailable")
+	}
+	defer r.Close()
+	limit := min(200, max(1, in.Limit))
+	if in.Limit == 0 {
+		limit = 80
+	}
+	matched := 0
+	err = fs.WalkDir(r.FS(), ".", func(p string, d fs.DirEntry, walkErr error) error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if walkErr != nil {
+			return walkErr
+		}
+		if d.IsDir() {
+			if p != "." && !allowedFile(p+"/probe.go") {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		if d.Type()&os.ModeSymlink != 0 || !allowedFile(p) || !strings.HasPrefix(p, in.Prefix) {
+			return nil
+		}
+		matched++
+		if matched <= in.Offset {
+			return nil
+		}
+		if len(out.Files) == limit {
+			out.Truncated = true
+			out.NextOffset = in.Offset + len(out.Files)
+			return fs.SkipAll
+		}
+		out.Files = append(out.Files, p)
+		return nil
+	})
+	return out, err
+}
+
+func (w *workspace) read(in fileReadInput) (fileRead, error) {
+	r, err := os.OpenRoot(w.dir)
+	if err != nil {
+		return fileRead{}, errors.New("workspace unavailable")
+	}
+	defer r.Close()
+	data, err := readText(r, in.Path)
+	if err != nil {
+		return fileRead{}, err
+	}
+	lines := strings.Split(string(data), "\n")
+	start := max(1, in.StartLine)
+	limit := 160
+	if in.Limit != 0 {
+		limit = min(240, max(1, in.Limit))
+	}
+	if start > len(lines) {
+		return fileRead{}, errors.New("startLine is beyond end of file")
+	}
+	end := min(len(lines), start-1+limit)
+	// Bound each response even for minified files.
+	text := strings.Join(lines[start-1:end], "\n")
+	if len(text) > 32<<10 {
+		return fileRead{}, errors.New("selected lines exceed 32 KiB; request a smaller range")
+	}
+	hash := digest(data)
+	return fileRead{Evidence: Evidence{ID: fmt.Sprintf("file:%s:%s:%d-%d", in.Path, hash[:16], start, end), Source: fmt.Sprintf("%s:%d-%d", in.Path, start, end), Text: text}, SHA256: hash, StartLine: start, EndLine: end, TotalLines: len(lines), Truncated: end < len(lines)}, nil
+}
+
+func (w *workspace) search(ctx context.Context, in fileSearchInput) (fileSearch, error) {
+	out := fileSearch{Evidence: []Evidence{}}
+	if strings.TrimSpace(in.Query) == "" || len(in.Query) > 200 || in.Offset < 0 || in.Offset > 100000 {
+		return out, errors.New("invalid query or offset")
+	}
+	r, err := os.OpenRoot(w.dir)
+	if err != nil {
+		return out, errors.New("workspace unavailable")
+	}
+	defer r.Close()
+	limit := 40
+	if in.Limit != 0 {
+		limit = min(80, max(1, in.Limit))
+	}
+	matched := 0
+	for offset := 0; ; {
+		files, err := w.list(ctx, fileListInput{Prefix: in.Prefix, Offset: offset, Limit: 200})
+		if err != nil {
+			return out, err
+		}
+		for _, p := range files.Files {
+			if ctx.Err() != nil {
+				return out, ctx.Err()
+			}
+			data, err := readText(r, p)
+			if err != nil {
+				out.SkippedFiles++
+				continue
+			}
+			hash := digest(data)
+			for line, text := range strings.Split(string(data), "\n") {
+				if !strings.Contains(strings.ToLower(text), strings.ToLower(in.Query)) {
+					continue
+				}
+				matched++
+				if matched <= in.Offset {
+					continue
+				}
+				if len(out.Evidence) == limit {
+					out.Truncated = true
+					out.NextOffset = in.Offset + len(out.Evidence)
+					return out, nil
+				}
+				if len(text) > 2000 {
+					text = string([]rune(text)[:min(500, len([]rune(text)))])
+				}
+				out.Evidence = append(out.Evidence, Evidence{ID: fmt.Sprintf("match:%s:%s:%d", p, hash[:16], line+1), Source: fmt.Sprintf("%s:%d", p, line+1), Text: text})
+			}
+		}
+		if !files.Truncated {
+			break
+		}
+		offset = files.NextOffset
+	}
+	return out, nil
+}
+
+func (w *workspace) write(in fileWriteInput, save bool) (fileWrite, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	out := fileWrite{Path: in.Path}
+	if !writableDocument(in.Path) {
+		return out, errors.New("writes are limited to README.md, CHANGELOG.md and docs/*.md")
+	}
+	if len(in.Content) > documentLimit || !utf8.ValidString(in.Content) || strings.ContainsRune(in.Content, '\x00') {
+		return out, errors.New("document must be UTF-8 text within 32 KiB")
+	}
+	r, err := os.OpenRoot(w.dir)
+	if err != nil {
+		return out, errors.New("workspace unavailable")
+	}
+	defer r.Close()
+	before, err := readText(r, in.Path)
+	missing := errors.Is(err, fs.ErrNotExist)
+	if err != nil && !missing {
+		return out, err
+	}
+	if missing && in.ExpectedSHA256 != "missing" || !missing && in.ExpectedSHA256 != digest(before) {
+		return out, errors.New("file_conflict: read current file and use its sha256, or missing for a new file")
+	}
+	if len(before) > documentLimit {
+		return out, errors.New("existing document exceeds 32 KiB")
+	}
+	after := []byte(in.Content)
+	out.SHA256 = digest(after)
+	out.Changed = missing || string(before) != in.Content
+	if out.Changed {
+		out.Diff = unifiedDiff(in.Path, string(before), in.Content, missing)
+	}
+	if !save {
+		return out, nil
+	}
+	if out.Changed {
+		if err = r.MkdirAll(path.Dir(in.Path), 0755); err != nil {
+			return out, errors.New("document directory cannot be created")
+		}
+		tmp := path.Join(path.Dir(in.Path), ".assistant-"+out.SHA256[:16]+".tmp")
+		f, err := r.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if err != nil {
+			return out, errors.New("temporary document cannot be created")
+		}
+		defer r.Remove(tmp)
+		_, err = f.Write(after)
+		if err == nil {
+			err = f.Sync()
+		}
+		closeErr := f.Close()
+		if err != nil || closeErr != nil {
+			return out, errors.New("document cannot be saved")
+		}
+		// Recheck immediately before publishing, preserving changes made during IO.
+		current, currentErr := readText(r, in.Path)
+		if missing && !errors.Is(currentErr, fs.ErrNotExist) || !missing && (currentErr != nil || digest(current) != in.ExpectedSHA256) {
+			return out, errors.New("file_conflict: file changed while preparing the write")
+		}
+		if err = r.Rename(tmp, in.Path); err != nil {
+			return out, errors.New("document cannot be replaced")
+		}
+	}
+	out.Saved = true
+	return out, nil
+}
+
+// A full-file hunk keeps diffs deterministic and valid without a subprocess.
+func unifiedDiff(p, before, after string, missing bool) string {
+	oldPath := "a/" + p
+	if missing {
+		oldPath = "/dev/null"
+	}
+	lines := func(s string) []string {
+		if s == "" {
+			return nil
+		}
+		return strings.Split(strings.TrimSuffix(s, "\n"), "\n")
+	}
+	old, new := lines(before), lines(after)
+	oldStart, newStart := 1, 1
+	if len(old) == 0 {
+		oldStart = 0
+	}
+	if len(new) == 0 {
+		newStart = 0
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "--- %s\n+++ b/%s\n@@ -%d,%d +%d,%d @@\n", oldPath, p, oldStart, len(old), newStart, len(new))
+	for i, line := range old {
+		b.WriteString("-" + line + "\n")
+		if i == len(old)-1 && !strings.HasSuffix(before, "\n") {
+			b.WriteString("\\ No newline at end of file\n")
+		}
+	}
+	for i, line := range new {
+		b.WriteString("+" + line + "\n")
+		if i == len(new)-1 && !strings.HasSuffix(after, "\n") {
+			b.WriteString("\\ No newline at end of file\n")
+		}
+	}
+	return b.String()
+}
diff --git a/internal/supportmcp/files_test.go b/internal/supportmcp/files_test.go
